# Copie para .env e preencha. O .env NUNCA vai para o git.

# Danbooru: comece pelo testbooru (instância de testes oficial).
# Troque para https://danbooru.donmai.us só quando tudo estiver validado.
DANBOORU_URL=https://testbooru.donmai.us
DANBOORU_LOGIN=
# Gere em: <DANBOORU_URL>/profile -> API Key. Se restringir permissões, inclua:
# uploads:create, uploads:show, posts:create, users:profile
DANBOORU_API_KEY=

# Sites com formulário. Opcional: se vazio, você digita no navegador durante `boorubot login`.
GELBOORU_USER=
GELBOORU_PASS=
PAHEAL_USER=
PAHEAL_PASS=
RULE34US_USER=
RULE34US_PASS=
RULE34XXX_USER=
RULE34XXX_PASS=
